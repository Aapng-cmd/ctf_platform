PORT=8000
DB_DRIVER=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ctfd
POSTGRES_USER=ctfd
POSTGRES_PASSWORD=ctfd
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
SECRET_KEY=change-this-to-a-long-random-string
UPLOAD_DIR=data/uploads
DATA_DIR=data
TASKS_DIR=data/tasks
PUBLIC_HOST=127.0.0.1
GIN_MODE=release
# Local hostname for the Docker HTTPS proxy. It is not a public domain.
# Point it at the server in each machine's hosts file:  <server-ip>  ctf.local
CERT_DOMAIN=ctf.local
# Optional extra certificate names, for example IP:10.0.0.5,DNS:ctf.lan
# CERT_SANS=
